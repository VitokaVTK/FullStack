<Page x:Class="SistemaFullStackApp.PaginaProdutos"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Produtos">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Cadastro e Listagem de Produtos"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="dgProdutos"
                      Grid.Column="0"
                      AutoGenerateColumns="True"
                      IsReadOnly="True"
                      GridLinesVisibility="Horizontal"
                      AlternatingRowBackground="#F2F2F2"
                      Margin="0,0,10,0"/>

            <StackPanel Grid.Column="1">

                <TextBlock Text="Produtos"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <ListBox x:Name="lbProdutos"
                         Height="250"/>

            </StackPanel>

        </Grid>

    </Grid>

</Page>